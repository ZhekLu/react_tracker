# Copy to backend/.env only when overriding these machine-local defaults.
TRACKER_HOST=127.0.0.1
TRACKER_PORT=8787
TRACKER_FRONTEND_ORIGIN=http://127.0.0.1:5174

# Runtime state defaults to react_tracker/data/. Override paths when needed.
# TRACKER_DATABASE_PATH=/absolute/path/to/tracker_v2.db
# TRACKER_HELPER_CONFIG_PATH=/absolute/path/to/toggl_config.json
# TRACKER_HELPER_STATE_PATH=/absolute/path/to/toggl_state.json
# TRACKER_DRAWBOARD_STATE_PATH=/absolute/path/to/drawboard_state.json
# TRACKER_COURSE_FILES_CONFIG_PATH=/absolute/path/to/course_files.json

