{
  "name": "react-study-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1 --port 5174",
    "build": "tsc -b && vite build --config vite.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1 --port 4174",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "map:build": "node ../scripts/build-rl-map.mjs",
    "map:check": "node ../scripts/build-rl-map.mjs --check",
    "prebuild": "npm run map:build",
    "predev": "npm run map:build",
    "pretest": "npm run map:build",
    "pretest:watch": "npm run map:build",
    "pretypecheck": "npm run map:build"
  },
  "dependencies": {
    "@tiptap/core": "3.27.0",
    "@tiptap/extension-bold": "3.27.0",
    "@tiptap/extension-code": "3.27.0",
    "@tiptap/extension-code-block-lowlight": "3.27.0",
    "@tiptap/extension-document": "3.27.0",
    "@tiptap/extension-heading": "3.27.0",
    "@tiptap/extension-highlight": "3.27.0",
    "@tiptap/extension-image": "3.27.0",
    "@tiptap/extension-italic": "3.27.0",
    "@tiptap/extension-link": "3.27.0",
    "@tiptap/extension-list-item": "3.27.0",
    "@tiptap/extension-mathematics": "3.27.0",
    "@tiptap/extension-ordered-list": "3.27.0",
    "@tiptap/extension-paragraph": "3.27.0",
    "@tiptap/extension-placeholder": "3.27.0",
    "@tiptap/extension-strike": "3.27.0",
    "@tiptap/extension-table": "3.27.0",
    "@tiptap/extension-task-item": "3.27.0",
    "@tiptap/extension-task-list": "3.27.0",
    "@tiptap/extension-underline": "3.27.0",
    "@tiptap/markdown": "3.27.0",
    "@tiptap/react": "3.27.0",
    "@tiptap/starter-kit": "3.27.0",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "26.1.0",
    "typescript": "latest",
    "typescript-eslint": "^8.62.0",
    "vite": "latest",
    "vitest": "^3.2.7"
  }
}
